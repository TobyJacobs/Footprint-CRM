# Copy to .env.local for running on your own computer.
# In Netlify, set these under Site configuration → Environment variables.
# Both values come from Supabase → Project Settings → API. They are safe to be
# public (row-level security protects the data). Never put the "secret" or
# "service_role" key here or anywhere in the code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry error alerts (EU region). From Sentry → Project Settings → Client Keys (DSN).
# Optional locally; leave empty to keep alerts off on your own computer.
NEXT_PUBLIC_SENTRY_DSN=

# Email via Postmark. POSTMARK_SERVER_TOKEN is SECRET (Netlify only, mark it as secret).
# Use the special value POSTMARK_API_TEST for Postmark's test mode (accepted, never delivered).
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="Footprint Group <accounts@footprintgroup.uk>"
EMAIL_REPLY_TO=
