# Copy to .env.local for running on your own computer.
# In Netlify, set these under Site configuration → Environment variables.
# Both values come from Supabase → Project Settings → API. They are safe to be
# public (row-level security protects the data). Never put the "secret" or
# "service_role" key here or anywhere in the code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
